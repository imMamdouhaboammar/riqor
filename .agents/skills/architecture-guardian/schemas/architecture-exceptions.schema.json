{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exceptions"],
  "properties": {
    "version": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "owner", "createdAt", "expiresAt", "status"],
        "anyOf": [
          { "required": ["ruleId"], "properties": { "ruleId": { "type": "string", "minLength": 1 } } },
          { "required": ["fingerprint"], "properties": { "fingerprint": { "type": "string", "minLength": 1 } } }
        ],
        "x-agent-kernel-temporal-constraints": {
          "expiresAfterCreatedAt": true,
          "maximumLifetimeDays": 90
        },
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ruleId": { "type": ["string", "null"] },
          "fingerprint": { "type": ["string", "null"] },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "status": { "enum": ["active", "revoked"] }
        }
      }
    }
  }
}
