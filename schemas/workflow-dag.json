{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiqorWorkflowDAG",
  "description": "Declarative DAG workflow schema for Riqor multi-step agent paths inspired by Dify",
  "type": "object",
  "required": ["version", "name", "nodes", "edges"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["start", "llm", "tool", "condition", "memory", "subagent", "end"]
          },
          "title": { "type": "string" },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    }
  }
}
